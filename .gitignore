.env
# R12 (EDW-1334): agent/auth.py's OAuth token store. Defaults outside the
# repo (~/.receipts), but ignored here too in case it is ever pointed at
# the tree: it holds an access token and a refresh token, as sensitive as
# any key in .env.
honeycomb_oauth.json
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
evals/results/*
!evals/results/runs.json
*.egg-info/
gen/runs/

# Claude Code agent worktrees
.claude/worktrees/

# tools/record/build.py output: clips, stills, and the finished mp4
tools/record/out/

# tools/record/remotion: the Remotion cut. public/ holds symlinks to
# tools/record/out/ made by sync.sh, never real copies; node_modules and
# Remotion's own render output are the usual JS build artifacts.
tools/record/remotion/public/
tools/record/remotion/node_modules/
tools/record/remotion/out/

# Finder metadata
.DS_Store
