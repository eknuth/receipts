{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Receipts Investigation Run",
    "output": "docs/diagrams/investigation.html",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "legend": {
      "entries": {
        "dashed": {
          "label": "rejection"
        }
      }
    },
    "viewBox": [
      1000,
      2605
    ]
  },
  "participants": [
    {
      "id": "model",
      "type": "external",
      "label": "Model",
      "sublabel": "provider in use"
    },
    {
      "id": "loop",
      "type": "backend",
      "label": "agent/loop.py",
      "sublabel": "investigation loop"
    },
    {
      "id": "mcp_client",
      "type": "backend",
      "label": "MCP client",
      "sublabel": "agent/mcp_client.py"
    },
    {
      "id": "hosted_mcp",
      "type": "cloud",
      "label": "Hosted MCP",
      "sublabel": "mcp.honeycomb.io"
    },
    {
      "id": "validate",
      "type": "backend",
      "label": "agent/validate.py",
      "sublabel": "receipts + not-checked"
    }
  ],
  "segments": [
    {
      "from": 200,
      "to": 380,
      "label": "Orient"
    },
    {
      "from": 425,
      "to": 645,
      "label": "Characterize"
    },
    {
      "from": 690,
      "to": 910,
      "label": "BubbleUp"
    },
    {
      "from": 955,
      "to": 1175,
      "label": "Split the candidates in time"
    },
    {
      "from": 1220,
      "to": 1440,
      "label": "Noise floor"
    },
    {
      "from": 1485,
      "to": 1705,
      "label": "Select the population"
    },
    {
      "from": 1750,
      "to": 1970,
      "label": "Trace"
    },
    {
      "from": 2015,
      "to": 2235,
      "label": "Verify by negation"
    },
    {
      "from": 2280,
      "to": 2545,
      "label": "Record + validate"
    }
  ],
  "messages": [
    {
      "id": "orient-ask",
      "from": "model",
      "to": "loop",
      "y": 215,
      "label": "tool_use: get_workspace_context, get_dataset_columns, find_queries",
      "variant": "emphasis"
    },
    {
      "id": "orient-dispatch",
      "from": "loop",
      "to": "mcp_client",
      "y": 250,
      "label": "dispatch orient calls"
    },
    {
      "id": "orient-call",
      "from": "mcp_client",
      "to": "hosted_mcp",
      "y": 285,
      "label": "get_workspace_context / get_dataset_columns / find_queries",
      "note": "paced: at most 40 calls per minute, 1.5s spacing, overage sleeps"
    },
    {
      "id": "orient-result",
      "from": "hosted_mcp",
      "to": "mcp_client",
      "y": 340,
      "label": "columns, no prior queries for this run",
      "variant": "return"
    },
    {
      "id": "orient-return",
      "from": "mcp_client",
      "to": "loop",
      "y": 375,
      "label": "compact tool result",
      "variant": "return"
    },
    {
      "id": "characterize-ask",
      "from": "model",
      "to": "loop",
      "y": 440,
      "label": "tool_use: run_query COUNT, P99(duration_ms), HEATMAP(duration_ms), granularity",
      "variant": "emphasis"
    },
    {
      "id": "characterize-dispatch",
      "from": "loop",
      "to": "mcp_client",
      "y": 480,
      "label": "dispatch run_query: COUNT, P99(duration_ms), HEATMAP(duration_ms), granularity"
    },
    {
      "id": "characterize-call",
      "from": "mcp_client",
      "to": "hosted_mcp",
      "y": 520,
      "label": "run_query, scoped to the run id and the window"
    },
    {
      "id": "characterize-result",
      "from": "hosted_mcp",
      "to": "mcp_client",
      "y": 560,
      "label": "query_id, time series",
      "variant": "return"
    },
    {
      "id": "characterize-return",
      "from": "mcp_client",
      "to": "loop",
      "y": 600,
      "label": "compact result: where the series steps",
      "variant": "return"
    },
    {
      "id": "bubbleup-ask",
      "from": "model",
      "to": "loop",
      "y": 705,
      "label": "tool_use: run_bubbleup (query_pk, selection)",
      "variant": "emphasis"
    },
    {
      "id": "bubbleup-dispatch",
      "from": "loop",
      "to": "mcp_client",
      "y": 745,
      "label": "dispatch run_bubbleup on the anomalous selection"
    },
    {
      "id": "bubbleup-call",
      "from": "mcp_client",
      "to": "hosted_mcp",
      "y": 785,
      "label": "run_bubbleup (query_pk, selection)"
    },
    {
      "id": "bubbleup-result",
      "from": "hosted_mcp",
      "to": "mcp_client",
      "y": 825,
      "label": "columns ranked by shift",
      "variant": "return"
    },
    {
      "id": "bubbleup-return",
      "from": "mcp_client",
      "to": "loop",
      "y": 865,
      "label": "compact result: candidate dimensions",
      "variant": "return"
    },
    {
      "id": "split-ask",
      "from": "model",
      "to": "loop",
      "y": 970,
      "label": "tool_use: run_query, granularity + candidate breakdown across the change point",
      "variant": "emphasis"
    },
    {
      "id": "split-dispatch",
      "from": "loop",
      "to": "mcp_client",
      "y": 1010,
      "label": "dispatch run_query: split each candidate's measurement on either side of the change"
    },
    {
      "id": "split-call",
      "from": "mcp_client",
      "to": "hosted_mcp",
      "y": 1050,
      "label": "run_query, WHERE dims, BREAKDOWN candidate, granularity"
    },
    {
      "id": "split-result",
      "from": "hosted_mcp",
      "to": "mcp_client",
      "y": 1090,
      "label": "series: same both sides, absent early, or present then larger",
      "variant": "return"
    },
    {
      "id": "split-return",
      "from": "mcp_client",
      "to": "loop",
      "y": 1130,
      "label": "compact result: which candidates date the onset",
      "variant": "return"
    },
    {
      "id": "noise-ask",
      "from": "model",
      "to": "loop",
      "y": 1235,
      "label": "tool_use: run_query, candidate column != or not-in, whole window",
      "variant": "emphasis"
    },
    {
      "id": "noise-dispatch",
      "from": "loop",
      "to": "mcp_client",
      "y": 1275,
      "label": "dispatch run_query: reference rate outside the candidate, row counts"
    },
    {
      "id": "noise-call",
      "from": "mcp_client",
      "to": "hosted_mcp",
      "y": 1315,
      "label": "run_query, candidate column excluded, whole window"
    },
    {
      "id": "noise-result",
      "from": "hosted_mcp",
      "to": "mcp_client",
      "y": 1355,
      "label": "reference rate + row count, bucket by bucket",
      "variant": "return"
    },
    {
      "id": "noise-return",
      "from": "mcp_client",
      "to": "loop",
      "y": 1395,
      "label": "compact result: candidate rate outside the spread, or inside it",
      "variant": "return"
    },
    {
      "id": "population-ask",
      "from": "model",
      "to": "loop",
      "y": 1500,
      "label": "tool_use: run_bubbleup on the dims so far, or run_query breakdown",
      "variant": "emphasis"
    },
    {
      "id": "population-dispatch",
      "from": "loop",
      "to": "mcp_client",
      "y": 1540,
      "label": "dispatch run_bubbleup / run_query, narrowing dims"
    },
    {
      "id": "population-call",
      "from": "mcp_client",
      "to": "hosted_mcp",
      "y": 1580,
      "label": "run_bubbleup (query_pk, dims filter) / run_query breakdown"
    },
    {
      "id": "population-result",
      "from": "hosted_mcp",
      "to": "mcp_client",
      "y": 1620,
      "label": "one value carries the change, or every value reads flat",
      "variant": "return"
    },
    {
      "id": "population-return",
      "from": "mcp_client",
      "to": "loop",
      "y": 1660,
      "label": "compact result: dims grown, or the leader ruled out",
      "variant": "return"
    },
    {
      "id": "trace-ask",
      "from": "model",
      "to": "loop",
      "y": 1765,
      "label": "tool_use: get_trace (trace_id)",
      "variant": "emphasis"
    },
    {
      "id": "trace-dispatch",
      "from": "loop",
      "to": "mcp_client",
      "y": 1805,
      "label": "dispatch get_trace on a representative span"
    },
    {
      "id": "trace-call",
      "from": "mcp_client",
      "to": "hosted_mcp",
      "y": 1845,
      "label": "get_trace (trace_id)"
    },
    {
      "id": "trace-result",
      "from": "hosted_mcp",
      "to": "mcp_client",
      "y": 1885,
      "label": "waterfall",
      "variant": "return"
    },
    {
      "id": "trace-return",
      "from": "mcp_client",
      "to": "loop",
      "y": 1925,
      "label": "compact result: span carrying the time",
      "variant": "return"
    },
    {
      "id": "negation-ask",
      "from": "model",
      "to": "loop",
      "y": 2030,
      "label": "tool_use: run_query, WHERE NOT the reported dims",
      "variant": "emphasis"
    },
    {
      "id": "negation-dispatch",
      "from": "loop",
      "to": "mcp_client",
      "y": 2070,
      "label": "dispatch run_query excluding the finding (!= or not-in on dims)"
    },
    {
      "id": "negation-call",
      "from": "mcp_client",
      "to": "hosted_mcp",
      "y": 2110,
      "label": "run_query, WHERE NOT the reported dims"
    },
    {
      "id": "negation-result",
      "from": "hosted_mcp",
      "to": "mcp_client",
      "y": 2150,
      "label": "outside traffic reads normal",
      "variant": "return"
    },
    {
      "id": "negation-return",
      "from": "mcp_client",
      "to": "loop",
      "y": 2190,
      "label": "compact result: negation holds",
      "variant": "return"
    },
    {
      "id": "submit",
      "from": "model",
      "to": "loop",
      "y": 2295,
      "label": "tool_use: submit_report",
      "variant": "emphasis"
    },
    {
      "id": "validate-check",
      "from": "loop",
      "to": "validate",
      "y": 2330,
      "label": "check receipts rule and not_checked against the tool log"
    },
    {
      "id": "validate-reject",
      "from": "validate",
      "to": "loop",
      "y": 2365,
      "label": "rejected: a query_id is not in the tool log",
      "variant": "dashed"
    },
    {
      "id": "loop-reject",
      "from": "loop",
      "to": "model",
      "y": 2400,
      "label": "rejected once; a second rejection files it flagged, 0.25 off",
      "variant": "dashed"
    },
    {
      "id": "resubmit",
      "from": "model",
      "to": "loop",
      "y": 2435,
      "label": "tool_use: submit_report (revised)",
      "variant": "emphasis"
    },
    {
      "id": "validate-recheck",
      "from": "loop",
      "to": "validate",
      "y": 2470,
      "label": "recheck against the tool log"
    },
    {
      "id": "validate-pass",
      "from": "validate",
      "to": "loop",
      "y": 2505,
      "label": "receipts rule and not_checked pass",
      "variant": "return"
    }
  ]
}
