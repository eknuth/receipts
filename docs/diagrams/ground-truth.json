{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Ground Truth to the Wire",
    "output": "docs/diagrams/ground-truth.html",
    "quality_profile": "showcase",
    "viewBox": [1080, 620]
  },
  "stages": [
    { "label": "Scenario" },
    { "label": "Generator" },
    { "label": "On the wire, plus the manifest" },
    { "label": "Index" },
    { "label": "Grading" }
  ],
  "nodes": [
    { "id": "scenario_yaml", "type": "external", "label": "Scenario YAML", "sublabel": "gen/scenarios/*.yml", "stage": 0, "row": 1 },
    { "id": "topology", "type": "backend", "label": "gen/topology.py", "sublabel": "span tree + attributes", "stage": 1, "row": 0 },
    { "id": "emit", "type": "backend", "label": "gen/emit.py", "sublabel": "OTLP/HTTP to Honeycomb", "stage": 1, "row": 2 },
    { "id": "on_wire", "type": "cloud", "label": "On the wire", "sublabel": "receipts-shop dataset", "tag": "agent can query", "stage": 2, "row": 2 },
    { "id": "manifest", "type": "security", "label": "Run manifest", "sublabel": "gen/runs/<run id>.json", "tag": "answer boundary", "stage": 2, "row": 0 },
    { "id": "runs_index", "type": "database", "label": "runs.json", "sublabel": "evals/results/runs.json", "tag": "index", "stage": 3, "row": 0 },
    { "id": "grader", "type": "backend", "label": "evals/grader.py", "sublabel": "reads scenario id, never spans", "width": 160, "stage": 4, "row": 0 }
  ],
  "flows": [
    { "id": "yaml-to-topology", "from": "scenario_yaml", "to": "topology", "label": "fault + ground_truth + herrings", "variant": "default", "labelDy": 16 },
    { "id": "topology-to-emit", "from": "topology", "to": "emit", "label": "span tree", "variant": "default", "labelDy": 24 },
    { "id": "emit-to-wire", "from": "emit", "to": "on_wire", "label": "OTLP export", "variant": "emphasis", "route": "straight", "labelDy": 40 },
    { "id": "emit-to-manifest", "from": "emit", "to": "manifest", "label": "run id + scenario id + window", "variant": "security" },
    { "id": "manifest-to-index", "from": "manifest", "to": "runs_index", "label": "copied into the index", "variant": "security", "labelDy": -23 },
    { "id": "index-to-grader", "from": "runs_index", "to": "grader", "label": "run id + window bounds", "variant": "default", "labelDy": -23 }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Every span carries",
      "items": [
        "scenario.run_id, the run id every query scopes to",
        "deployment.version, cloud.region, payment.provider — the three dims a fault or a red herring selects on",
        "service.component, naming the real service; error on a failing span and every ancestor above it"
      ]
    },
    {
      "dot": "emerald",
      "title": "The root span adds",
      "items": [
        "customer.id, 2,000 Zipf-weighted ids",
        "cart.size, http.route, http.status_code",
        "db.statement.hash — also on inventory-db's own db.query span"
      ]
    },
    {
      "dot": "rose",
      "title": "Answer-leak boundary",
      "items": [
        "scenario.id never rides on a span, only scenario.run_id does",
        "gen/runs/<run id>.json is the only place a run id maps to a scenario id",
        "evals/grader.py reads that id from the manifest, never from a query result"
      ]
    },
    {
      "dot": "amber",
      "title": "Dataset guard",
      "items": [
        "agent/mcp_client.py refuses any dataset_slug other than receipts-shop",
        "the agent's own self-telemetry lands in receipts-investigator, a dataset it never queries",
        "querying its own spans could hand it a prior run's grade"
      ]
    }
  ]
}
