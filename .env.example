# Honeycomb environment "receipts-demo"
# Ingest key, used as x-honeycomb-team for OTLP. Optional: leave it unset to
# run the agent without self-telemetry. gen/emit.py needs a real one and
# fails with a clear message if it is missing.
HONEYCOMB_INGEST_KEY=
# Management v2 key, form key_id:secret, used as the MCP Bearer token.
HONEYCOMB_MCP_KEY=
HONEYCOMB_MCP_URL=https://mcp.honeycomb.io/mcp
HONEYCOMB_OTLP_ENDPOINT=https://api.honeycomb.io
HONEYCOMB_DATASET=receipts-shop
HONEYCOMB_ENV=receipts-demo
# R12 (EDW-1334): "key" (default) uses HONEYCOMB_MCP_KEY above for
# everything, including the eval matrix. "oauth" is needed only for Canvas
# (canvas_agent_invoke); run `uv run python -m agent.auth login` first.
HONEYCOMB_AUTH=
# Where agent/auth.py's OAuth token store lives. Leave unset for the default
# (~/.receipts/honeycomb_oauth.json, outside the repo); never point this at
# a path under the repo.
HONEYCOMB_OAUTH_TOKEN_PATH=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Identity-linked keys need this sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=

# R11 only
AWS_PROFILE=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=

# R15, local provider
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# R15, NVIDIA hosted NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# R9 self-telemetry. Set to 1 to record prompts and completions on the
# chat spans. Off by default; leave it unset or 0 for a normal run.
RECEIPTS_CAPTURE_CONTENT=0
