# Honeycomb environment "receipts-demo"
# Ingest key, used as x-honeycomb-team for OTLP. Optional: leave it unset to
# run the agent without self-telemetry. gen/emit.py needs a real one and
# fails with a clear message if it is missing.
HONEYCOMB_INGEST_KEY=
# Management v2 key, form key_id:secret, used as the MCP Bearer token.
HONEYCOMB_MCP_KEY=
HONEYCOMB_MCP_URL=https://mcp.honeycomb.io/mcp
HONEYCOMB_OTLP_ENDPOINT=https://api.honeycomb.io
HONEYCOMB_DATASET=receipts-shop
HONEYCOMB_ENV=receipts-demo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Identity-linked keys need this sent as the anthropic-workspace-id header.
ANTHROPIC_WORKSPACE_ID=

# R11 only
AWS_PROFILE=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=

# R15, local provider
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b

# R9 self-telemetry. Set to 1 to record prompts and completions on the
# chat spans. Off by default; leave it unset or 0 for a normal run.
RECEIPTS_CAPTURE_CONTENT=0
