HONEYCOMB_ENV_SLUG=receipts-demo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Day 6 only
AWS_PROFILE=
AWS_REGION=us-west-2
