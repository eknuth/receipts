# Honeycomb environment "receipts-demo"
HONEYCOMB_INGEST_KEY=            # ingest key, used as x-honeycomb-team for OTLP
HONEYCOMB_MCP_KEY=              # management v2 key, form key_id:secret, MCP Bearer token
HONEYCOMB_MCP_URL=https://mcp.honeycomb.io/mcp
HONEYCOMB_OTLP_ENDPOINT=https://api.honeycomb.io
HONEYCOMB_DATASET=receipts-shop
HONEYCOMB_ENV=receipts-demo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_WORKSPACE_ID=              # identity-linked keys need this as the anthropic-workspace-id header

# Day 6 only
AWS_PROFILE=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=

# R15, local provider
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.8:27b
